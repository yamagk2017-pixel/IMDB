{
  "name": "imdb",
  "version": "1.0.0",
  "description": "This repository tracks the schema and operational assets for the idol master database (IMDB) that lives inside the Supabase project **supabase-buzzttara**. Use it as the single source of truth for schema, policies, seeds, and operational docs shared across the other idol-related apps.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test script/**/*.test.ts",
    "profile:sheet:setup": "tsx script/profile_workflow/setup_sheet.ts",
    "profile:generate": "tsx script/profile_workflow/generate.ts",
    "profile:publish": "tsx script/profile_workflow/publish.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@supabase/supabase-js": "^2.84.0",
    "csv-parse": "7.0.2",
    "dotenv": "^17.2.3",
    "googleapis": "178.1.1",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "22.20.2",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "tsx": "4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
